<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- NBitcoin Flavor: Standard (public NuGet) or Okeanos (internal fork) -->
    <NBitcoinFlavor Condition="'$(NBitcoinFlavor)' == ''">Standard</NBitcoinFlavor>
    
    <!-- Package Metadata -->
    <PackageId>PonziTech.BitVM.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>PonziTech</Authors>
    <Company>PonziTech</Company>
    <Description>C# bindings for BitVM2 - Core operations (script execution, Winternitz signatures, hash functions)</Description>
    <PackageTags>bitcoin;bitvm;bridge;layer2;snark;script</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PonziTech/BitVM</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PonziTech/BitVM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Conditional NBitcoin reference -->
    <PackageReference Include="NBitcoin" Condition="'$(NBitcoinFlavor)' != 'Okeanos'" />
    <ProjectReference Include="..\..\..\external\NBitcoin\NBitcoin.csproj" Condition="'$(NBitcoinFlavor)' == 'Okeanos'">
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
    
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PonziTech.BitVM.Native\PonziTech.BitVM.Native.csproj" />
  </ItemGroup>

</Project>
